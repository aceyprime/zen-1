wait 1500
press HOME
wait 800
release HOME
wait 100
expect par0 5
# a power cut on program 6 of the next save (the project in five 64-byte pieces, then the commit): the save before stays
turn SELECT 1 80
wait 100
expect par0 6
jrtear 6
tap SAVE
wait 50
reboot
wait 1500
press HOME
wait 800
release HOME
wait 100
expect par0 5
# and saving goes on (the torn slot is skipped, never written over)
turn SELECT 1 80
wait 100
tap SAVE
wait 50
reboot
wait 1500
press HOME
wait 800
release HOME
wait 100
expect par0 6
expect store_writes 0
# fifty saves: the journal fills (>= 56 a power-on now) and reclaims a sector of itself when full (not
# OBJ_PROJ's); the last one wins
turn SELECT -1 80
wait 70
tap SAVE
