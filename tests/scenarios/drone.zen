# OCT+ / OCT- (the scene's octave): the drone stays where it was
tap OCT+
wait 100
expect par6 1
expect dronetop <401
expect dronelow >150
expect dronelow <330
tap OCT-
tap OCT-
wait 100
expect par6 -1
expect dronetop <401
expect dronelow >150
expect dronelow <330
