# MIDI in plays notes (chromatic); key presses send notes out
# ZEN-1 boots into a scene: HOME held, the instrument
press HOME
wait 800
release HOME
wait 100
expect mode 0
wav midi.wav
midi 90 45 64
wait 500
expect nvoices 1
midi 80 45 00
wait 3600
expect nvoices 0
key w5 down
wait 100
key w5 up
wait 300
# the key's note on and off, after the all-notes-off sent when the mode changed to the instrument
expect midi_out 3
midi B0 7B 00
wait 100
wavstop
expect peak_db_max -0.1
